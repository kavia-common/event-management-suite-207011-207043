# Backend example .env
# These variables are used by Flask to bootstrap the API and database.

# Flask secret key (change in production!)
SECRET_KEY=dev-secret

# Database connection
DATABASE_URL=sqlite:///event_management.db
# Example for PostgreSQL (if deployed):
# DATABASE_URL=postgresql://username:password@localhost:5432/event_management

# Allowed frontend origin for CORS (default: http://localhost:3000)
CORS_ORIGINS=http://localhost:3000
